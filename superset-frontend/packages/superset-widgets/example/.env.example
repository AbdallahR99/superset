# Copy to .env and fill in. .env is git-ignored.
#
# Variables that start with SUPERSET_URL, EMBED_ or FILTER_ are compiled into
# the browser bundle (vite.config.ts, envPrefix). Everything else, notably
# the credentials and the BROKER_ settings, stays with server.mjs.

# --- Where Superset is --------------------------------------------------
# Superset origin, used by the browser and the broker.
SUPERSET_URL=http://localhost:8088

# session (default): the viewer's own Superset login; no backend needed.
# guest: guest tokens from the broker (npm run broker).
EMBED_AUTH=session

# --- The dataset the page queries ---------------------------------------
# Defaults describe Superset's `birth_names` example. To use other data,
# name the dataset and the columns and metric to show from it.
#
# Session mode treats these as a preference: the app looks the dataset up by
# FILTER_DATASET_TABLE (ids differ between deployments) and replaces any
# column or metric the dataset does not have. Guest mode cannot read the
# dataset API, so there every value, the id included, is used as written and
# must be right:  GET /api/v1/dataset/?q=(filters:!((col:table_name,opr:eq,value:<name>)))
FILTER_DATASET_TABLE=birth_names
FILTER_DATASET_ID=17
# The dimension the charts group by, which the host's filter narrows.
FILTER_COLUMN=state
# Values of FILTER_COLUMN offered by the host's filter control.
FILTER_VALUES=CA,NY,TX,IL,FL
# A saved metric of the dataset, and a second one.
EMBED_METRIC=sum__num
EMBED_SECOND_METRIC=count
# A numeric column, for the demo that aggregates one ad hoc.
EMBED_METRIC_COLUMN=num
# A low-cardinality column, for the pie and the scoped filter.
EMBED_CATEGORY=gender
EMBED_CATEGORY_VALUES=boy,girl
# A high-cardinality column, for the table's rows.
EMBED_LABEL=name

# --- The second, independent provider -----------------------------------
# "Two independent providers" renders the same widgets twice, each under a
# provider of its own. Left empty, provider B uses the dataset above, which
# already shows the isolation. Name another dataset to put the two providers
# on different data (and, in guest mode, on tokens for different datasets).
EMBED_B_DATASET_TABLE=
EMBED_B_DATASET_ID=
EMBED_B_METRIC=
EMBED_B_DIMENSION=
EMBED_B_VALUES=

# --- Saved and extension widgets ----------------------------------------
# Saved widget uuids (GET /api/v1/widget/), rendered with <Widget id>.
EMBED_WIDGET_IDS=
# A uuid that no saved widget has, e.g. 00000000-0000-0000-0000-000000000000.
# Set it to show the gallery's renderError demo, which asks Superset for that
# widget and draws the 404. Empty: the demo is hidden and nothing fails.
EMBED_MISSING_WIDGET_ID=
# A widget type an extension contributes, e.g.
# extensions.<publisher>.<name>.<type>. Set it to render one; the page loads
# that extension from Superset at runtime. Guest-token pages also need
# EMBEDDED_EXTENSION_ASSETS_PUBLIC = True on the Superset side.
EMBED_EXTENSION_WIDGET=

# --- Right to left -------------------------------------------------------
# The locale the "العربية (RTL)" toggle switches the providers to.
EMBED_RTL_LOCALE=ar

# --- Broker only (guest mode); never sent to the browser -----------------
# A Superset account that may mint guest tokens (`can grant guest token on
# SecurityRestApi`) and can read every dataset and saved widget it grants.
# There are no defaults: the broker refuses to start without them.
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
BROKER_PORT=3001
# The origin of the page allowed to ask the broker for tokens.
BROKER_ALLOWED_ORIGIN=http://localhost:5173
# Optional row-level rule per audience, as a SQL condition on that audience's
# dataset, e.g.  state = 'CA'. Required when the dataset carries RLS rules in
# Superset. A real broker derives it from its own signed-in user.
BROKER_RLS_A=
BROKER_RLS_B=
