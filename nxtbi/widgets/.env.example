# Template for nxtbi/widgets/.env. Do not copy it by hand: run
#   python nxtbi/widgets/scripts/gen_env.py
# which replaces every __GENERATE__ with a random secret.
# This file belongs to the compose project "nxtbi-widgets" only; it shares nothing
# with nxtbi/.env of the main demo.

# ---- secrets (generated) ---------------------------------------------------------------
SUPERSET_SECRET_KEY=__GENERATE__
GUEST_TOKEN_JWT_SECRET=__GENERATE__
MCP_JWT_SECRET=__GENERATE__
POSTGRES_PASSWORD=__GENERATE__
EXAMPLES_PASSWORD=__GENERATE__
WIDGETS_ADMIN_PASSWORD=__GENERATE__
WIDGETS_GAMMA_PASSWORD=__GENERATE__

# ---- accounts ----------------------------------------------------------------------------
WIDGETS_ADMIN_USERNAME=admin
WIDGETS_GAMMA_USERNAME=widgets_gamma

# ---- endpoints (host side) ---------------------------------------------------------------
SUPERSET_PUBLIC_URL=http://localhost:8089
SUPERSET_FLAG_OFF_URL=http://localhost:8099
MCP_SERVICE_URL=http://localhost:5009
EXAMPLE_APP_URL=http://localhost:5173
EXAMPLE_APP_GUEST_URL=http://localhost:5174
# Port 3001 is commonly taken on the machine this was built on.
BROKER_PORT=3011

# ---- behaviour ---------------------------------------------------------------------------
# db (default): username/password login. keycloak: the main demo's OIDC settings, unchanged.
NXTBI_WIDGETS_AUTH=db
# on (default) / off: the DASHBOARD_V2 feature flag of the web and MCP containers.
NXTBI_WIDGETS_DASHBOARD_V2=on
# on / off (default): the ENABLE_EXTENSIONS feature flag.
NXTBI_WIDGETS_EXTENSIONS=off
# Origins allowed to call the API cross-origin (the standalone example app).
NXTBI_WIDGETS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# on / off (default): also give the guest role "can read on Dashboard", which the
# embedded Dashboard V2 document route needs. The widget endpoints do not need it.
NXTBI_WIDGETS_GUEST_DASHBOARD_READ=off

# ---- only for NXTBI_WIDGETS_AUTH=keycloak (copy with gen_env.py --copy-keycloak) ---------
KEYCLOAK_BROWSER_URL=http://localhost:8180
KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8180
KEYCLOAK_REALM=nxtbi
KEYCLOAK_CLIENT_ID=nxtbi-superset
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SCOPE=openid groups
NXTBI_PLATFORM_ADMINS=
