# NxtBI Superset demo - environment template.
# Do NOT copy this file. Create the real one with:   python nxtbi/scripts/gen_env.py
# Every value equal to __GENERATE__ is replaced by a random secret. nxtbi/.env is git-ignored.
# After pulling a newer template:                    python nxtbi/scripts/gen_env.py --add-missing

# ---- Superset core -------------------------------------------------------------------
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_SECRET_KEY=__GENERATE__
GUEST_TOKEN_JWT_SECRET=__GENERATE__
# yes = also load Superset's bundled example dashboards into the "examples" database
SUPERSET_LOAD_EXAMPLES=yes

# ---- Postgres (one container: metadata + examples + NxtBI demo warehouse) ------------
# Passwords are applied when the database volume is first created. If you regenerate this
# file while keeping the volume, the stack cannot log in: keep the file, or run `down -v`.
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=__GENERATE__
EXAMPLES_PASSWORD=__GENERATE__
NXTBI_DEMO_OWNER_PASSWORD=__GENERATE__
NXTBI_DEMO_RO_PASSWORD=__GENERATE__

# ---- Local service account (REST API, scheduled reports) -------------------------------
# Not usable in the browser: the login page only offers Keycloak.
SUPERSET_SERVICE_USERNAME=nxtbi-service
SUPERSET_SERVICE_PASSWORD=__GENERATE__

# ---- Keycloak (existing NxtBI instance; nothing is started by this stack) -------------
# Browser-facing base URL (same host NxtDash uses, so the SSO cookie is shared).
KEYCLOAK_BROWSER_URL=http://localhost:8180
# Base URL as seen from the Superset containers. On native Linux a port published on the
# host loopback is not reachable this way: see "Troubleshooting" in nxtbi/README.md.
KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8180
KEYCLOAK_REALM=nxtbi
KEYCLOAK_CLIENT_ID=nxtbi-superset
KEYCLOAK_CLIENT_SECRET=__GENERATE__
# Used only by nxtbi/scripts/keycloak_setup.py on the host (never passed to a container).
# Both are specific to the machine this demo was built on: adjust them on another machine.
KEYCLOAK_CONTAINER=ld-shared-keycloak-1
NXTBI_REALM_FILE=D:/DDWork/nxtdash-w4-int/docker/keycloak/realm-nxtbi.json

# ---- NxtBI mapping --------------------------------------------------------------------
# Keycloak usernames that receive the Superset Admin role (comma separated).
NXTBI_PLATFORM_ADMINS=superset.admin@nxtbi.local
# Host-only: password of the dedicated SSO platform admin created by keycloak_setup.py.
SUPERSET_SSO_ADMIN_PASSWORD=__GENERATE__
# Host-only: password of the realm demo users. keycloak_setup.py fills this in.
NXTBI_DEMO_USER_PASSWORD=

# ---- Mail (alerts & reports) - the Mailpit sink that already runs on the host ---------
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_MAIL_FROM=nxtbi-superset@nxtbi.local

# ---- MCP ------------------------------------------------------------------------------
# local-jwt (default): bearer tokens minted by nxtbi/scripts/mcp_token.py
# dev: no authentication, every call is the Admin service account (any local process or
#      container can reach the port) | keycloak: realm access tokens (not tested)
NXTBI_MCP_AUTH=local-jwt
MCP_JWT_SECRET=__GENERATE__

# ---- Optional switches (uncomment to use) ----------------------------------------------
# Superset feature flags to switch on by name, e.g. SEMANTIC_LAYERS,DATASET_FOLDERS
# NXTBI_EXPERIMENTAL_FLAGS=
# One-shot switches for the superset-init service:
# NXTBI_FORCE_SEED=yes
# SUPERSET_FORCE_LOAD_EXAMPLES=yes
# NXTBI_SKIP_CONTENT_IMPORT=yes
# Mailpit API used by smoke_test.py (reports group):
# MAILPIT_URL=http://localhost:8025
